---
import Base from '../layouts/Base.astro';
---

<Base
  title="Pipelines"
  description="Interactive maps of real production pipelines, showing which steps are technical chores and which are craft."
>
  <h1>Pipelines</h1>
  <p class="lede">
    How work moves through a production, task by task, and what each pipeline looks like
    inside: every step, and how much of it is technical chore versus actual craft.
  </p>

  <div class="network-frame full-bleed">
    <iframe src="/task-map/network.html" title="Production pipeline network"></iframe>
  </div>
  <p class="frame-note">
    Drag to pan, scroll to zoom. Filled-in tasks have a working pipeline; click a software
    icon on one to open its map below.
  </p>

  <div class="map-frame full-bleed" id="pipeline-map-section">
    <iframe
      id="pipeline-map"
      src="/task-map/"
      title="Pipeline map"
      loading="lazy"
    ></iframe>
  </div>
</Base>

<style>
  /* Full-bleed: break out of the 42rem reading column to the window's full width. */
  :global(body) {
    overflow-x: clip;
  }
  .full-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    background: #0d0d0f;
  }
  .network-frame iframe {
    display: block;
    width: 100%;
    height: max(32rem, 75vh);
    border: 0;
  }
  .frame-note {
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.75rem 0 2.5rem;
  }
  .map-frame iframe {
    display: block;
    width: 100%;
    height: 100vh;
    border: 0;
    transform-origin: top left;
  }
</style>

<script>
  // Below this width the six phase columns no longer fit, so the map is laid out at
  // this width and scaled down rather than cut off.
  const MIN_WIDTH = 1400;
  const wrap = document.querySelector('.map-frame') as HTMLElement | null;
  const frame = document.getElementById('pipeline-map') as HTMLIFrameElement | null;

  function fit() {
    const body = frame?.contentDocument?.body;
    if (!wrap || !frame || !body?.querySelector('#task-root')) return;
    const scale = Math.min(1, wrap.clientWidth / MIN_WIDTH);
    frame.style.width = scale < 1 ? `${MIN_WIDTH}px` : '100%';
    frame.style.transform = scale < 1 ? `scale(${scale})` : '';
    // The map is served from this site, so read its content height directly and
    // size the frame to it: no scrollbar inside the frame.
    const h = body.scrollHeight;
    frame.style.height = `${h}px`;
    wrap.style.height = `${Math.ceil(h * scale)}px`;
  }

  // Re-fit on load, on resize, and on a light poll: switching pipelines and late
  // icon loads change the map's height without any event the page can see.
  frame?.addEventListener('load', fit);
  window.addEventListener('resize', fit);
  setInterval(fit, 500);
  fit();

  // The network view asks to open a pipeline (a click on a live software icon):
  // scroll to the map and switch its selectors to that department + software.
  function openPipeline(software: string, task: string, triesLeft = 100) {
    const doc = frame?.contentDocument;
    const dept = doc?.getElementById('tb-dept') as HTMLSelectElement | null;
    const sw = doc?.getElementById('tb-software') as HTMLSelectElement | null;
    if (!dept || !sw) {
      // The map loads lazily; wait for its selectors to exist.
      if (triesLeft > 0) setTimeout(() => openPipeline(software, task, triesLeft - 1), 100);
      return;
    }
    dept.value = task;
    dept.dispatchEvent(new Event('change'));
    sw.value = software;
    sw.dispatchEvent(new Event('change'));
  }

  window.addEventListener('message', (e) => {
    if (e.origin !== location.origin || e.data?.type !== 'alc-open-pipeline') return;
    document.getElementById('pipeline-map-section')?.scrollIntoView({ behavior: 'smooth' });
    openPipeline(String(e.data.software), String(e.data.task));
  });
</script>
